# Copy to .env and replace every required value before starting.
# Generate MASTER_KEY_B64: openssl rand -base64 32
# Generate JWT_SECRET:     openssl rand -hex 32
# Generate other secrets: openssl rand -base64 36

APP_ENV=production
APP_VERSION=local
HTTP_PORT=8080
BIND_ADDRESS=0.0.0.0

POSTGRES_PASSWORD=replace-with-a-long-random-database-password
POSTGRES_MAX_CONNS=80
POSTGRES_MIN_CONNS=5
POSTGRES_RETENTION_DAYS=7
POSTGRES_SERVER_MAX_CONNECTIONS=300
POSTGRES_SHARED_BUFFERS=512MB
POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB

MASTER_KEY_B64=replace-with-base64-for-exactly-32-random-bytes
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=newapi-risk-platform
JWT_TTL=8h
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-14-characters

# Optional bootstrap tracking client for New API request-event callbacks.
BOOTSTRAP_TRACKING_KEY_ID=newapi-default
BOOTSTRAP_TRACKING_SECRET=

# Optional default OpenAI-compatible small audit model.
# Example: http://audit-model:8000/v1 only when private upstream mode is enabled.
AUDIT_DEFAULT_ENDPOINT=
AUDIT_DEFAULT_MODEL=audit-small
AUDIT_DEFAULT_API_KEY=
AUDIT_DEFAULT_TIMEOUT=8s
AUDIT_DEFAULT_BLOCK_THRESHOLD=0.65

ERROR_HTTP_STATUS=555
REQUEST_MAX_BYTES=8388608
RESPONSE_INSPECT_MAX_BYTES=2097152
AUDIT_TEXT_MAX_BYTES=262144
SSE_LINE_MAX_BYTES=1048576
GLOBAL_MAX_CONCURRENCY=4096
TRACE_QUEUE_SIZE=32768
TRACE_BATCH_SIZE=256
TRACE_FLUSH_INTERVAL=250ms
REDIS_STREAM_MAXLEN=100000

# Keep false for public providers. Set both values true only when routing to private
# model endpoints, and restrict container/Kubernetes egress to explicit destinations.
ALLOW_PRIVATE_UPSTREAMS=false
ACK_PRIVATE_UPSTREAM_SSRF_RISK=false
UPSTREAM_TLS_MIN_VERSION=1.2

# Kafka is optional. Start the bundled single-node development broker with:
# docker compose --profile longterm up -d
KAFKA_ENABLED=false
KAFKA_BROKERS=kafka:9092
KAFKA_TOPIC=risk.request.events.v1
KAFKA_CLIENT_ID=newapi-risk-platform
KAFKA_TLS=false
KAFKA_SASL_MECHANISM=
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_QUEUE_SIZE=8192
KAFKA_TOPIC_PARTITIONS=12
KAFKA_LOG_RETENTION_HOURS=720
