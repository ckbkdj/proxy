APP_ENV=development
LISTEN_ADDR=:8080
PUBLIC_BASE_URL=http://localhost:8080

DATABASE_URL=postgres://riskgate:riskgate@postgres:5432/riskgate?sslmode=disable
DB_MAX_CONNS=80
DB_MIN_CONNS=10
DB_CONNECT_TIMEOUT=5s

REDIS_URL=redis://redis:6379/0
REDIS_REQUIRED=false
REDIS_PREFIX=riskgate

# 生产环境至少 32 字节，不能使用示例值。
ADMIN_JWT_SECRET=change-me-to-at-least-32-random-bytes
TRACE_HMAC_SECRET=change-me-to-at-least-32-random-bytes
# 32 字节原始密钥的 base64；例如：openssl rand -base64 32
MASTER_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
PROMPT_HASH_SECRET=change-me-to-at-least-32-random-bytes

BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeThisPasswordNow!123
BOOTSTRAP_ADMIN_ROLE=admin

DEFAULT_RETENTION_DAYS=7
MAX_REQUEST_BYTES=8388608
MAX_RESPONSE_BYTES=33554432
MAX_SSE_FRAME_BYTES=1048576
STREAM_GATE_BYTES=65536
STREAM_GATE_TIMEOUT=1200ms
UPSTREAM_HEADER_TIMEOUT=60s
UPSTREAM_IDLE_TIMEOUT=120s
AUDIT_DEFAULT_TIMEOUT=8s
AUDIT_MAX_TEXT_BYTES=131072
AUDIT_CACHE_TTL=10m
TRACE_QUEUE_SIZE=32768
TRACE_WORKERS=8
OUTBOX_WORKERS=4
FAIL_CLOSED=true
ALLOW_PRIVATE_UPSTREAMS=false
TRUST_PROXY_HEADERS=false

# Kafka 留空即禁用；启用后事件由 PostgreSQL Outbox 保证最终投递。
KAFKA_BROKERS=
KAFKA_TOPIC=riskgate.audit.events.v1
KAFKA_CLIENT_ID=riskgate
KAFKA_TLS=false
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_RETENTION_HOURS=720
KAFKA_AUTO_CONFIGURE_TOPIC=false

LOG_LEVEL=info
